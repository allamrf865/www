
@article{feldkamp_gastroschisis_2024,
	title = {Gastroschisis prevalence patterns in 27 surveillance programs from 24 countries, {International} {Clearinghouse} for {Birth} {Defects} {Surveillance} and {Research}, 1980–2017},
	volume = {116},
	copyright = {© 2024 The Authors. Birth Defects Research published by Wiley Periodicals LLC.},
	issn = {2472-1727},
	url = {https://onlinelibrary.wiley.com/doi/abs/10.1002/bdr2.2306},
	doi = {10.1002/bdr2.2306},
	abstract = {Background Gastroschisis is a serious birth defect with midgut prolapse into the amniotic cavity. The objectives of this study were to evaluate the prevalence and time trends of gastroschisis among programs in the International Clearinghouse for Birth Defects Surveillance and Research (ICBDSR), focusing on regional variations and maternal age changes in the population. Methods We analyzed data on births from 1980 to 2017 from 27 ICBDSR member programs, representing 24 countries and three regions (Europe+ (includes Iran), Latin America, North America). Cases were identified using diagnostic codes (i.e., 756.7, 756.71, or Q79.3). We excluded cases of amniotic band syndrome, limb–body wall defect, and ruptured omphalocele. Programs provided annual counts for gastroschisis cases (live births, stillbirths, and legally permitted pregnancy terminations for fetal anomalies) and source population (live births, stillbirths), by maternal age. Results Overall, gastroschisis occurred in 1 of every 3268 births (3.06 per 10,000 births; 95\% confidence intervals [CI]: 3.01, 3.11), with marked regional variation. European+ prevalence was 1.49 (95\%CI: 1.44, 1.55), Latin American 3.80 (95\%CI: 3.69, 3.92) and North American 4.32 (95\%CI: 4.22, 4.42). A statistically significant increasing time trend was observed among six European+, four Latin American, and four North American programs. Women {\textless}20 years of age had the highest prevalence in all programs except the Slovak Republic. Conclusions Gastroschisis prevalence increased over time in 61\% of participating programs, and the highest increase in prevalence was observed among the youngest women. Additional inquiry will help to assess the impact of the changing maternal age proportions in the birth population on gastroschisis prevalence.},
	language = {en},
	number = {2},
	urldate = {2025-11-25},
	journal = {Birth Defects Research},
	author = {Feldkamp, Marcia L. and Canfield, Mark A. and Krikov, Sergey and Prieto-Merino, David and Šípek Jr, Antonin and LeLong, Nathalie and Amar, Emmanuelle and Rissmann, Anke and Csaky-Szunyogh, Melinda and Tagliabue, Giovanna and Pierini, Anna and Gatt, Miriam and Bergman, Jorieke E. H. and Szabova, Elena and Bermejo-Sánchez, Eva and Tucker, David and Dastgiri, Saeed and Bidondo, María Paz and Canessa, Aurora and Zarante, Ignacio and Hurtado-Villa, Paula and Martinez, Laura and Mutchinick, Osvaldo M. and Camelo, Jorge Lopez and Benavides-Lara, Adriana and Thomas, Mary Ann and Liu, Shiliang and Nembhard, Wendy N. and Gray, Elizabeth B. and Nance, Amy E. and Mastroiacovo, Pierpaolo and Botto, Lorenzo D.},
	year = {2024},
	note = {\_eprint: https://onlinelibrary.wiley.com/doi/pdf/10.1002/bdr2.2306},
	keywords = {gastroschisis, geographic region, multinational, prevalence, surveillance},
	pages = {e2306},
	file = {Full Text PDF:files/3302/Feldkamp et al. - 2024 - Gastroschisis prevalence patterns in 27 surveillance programs from 24 countries, International Clear.pdf:application/pdf;Snapshot:files/3303/bdr2.html:text/html},
}

@article{egger_gastroschisis_2022,
	title = {Gastroschisis annual incidence, mortality, and trends in extreme {Southern} {Brazil}},
	volume = {98},
	issn = {0021-7557},
	url = {https://www.sciencedirect.com/science/article/pii/S0021755721000796},
	doi = {10.1016/j.jped.2021.04.007},
	abstract = {Objective
To analyze gastroschisis annual incidence, mortality rates, and trends in the Brazilian state of Rio Grande do Sul from the year 2000 to the year 2017.
Method
Population-based study with the analysis of the temporal trend of gastroschisis annual incidence and mortality rates. Data were obtained from the Live Birth Information System and the Mortality Information System, with the analysis performed by polynomial regression modeling.
Results
There were 2,612,532 live births, 705 hospitalizations, and 233 deaths due to gastroschisis. The annual incidence of gastroschisis was 2.69 per 10,000 live births. The annual incidence rate increased by 85\% in the total period (p = 0.003), and mortality was 33\% in the 2000-2017 period. Maternal age {\textless} 25 years was a risk factor for gastroschisis (p {\textless} 0.001). Children were more likely to be born weighing {\textless} 2,500 g (p {\textless} 0.001) and with a gestational age {\textless} 37 weeks (p {\textless} 0.001). The annual incidence trend was to increase, and the mortality trend was to decrease.
Conclusion
Similar to what has been described in several regions/countries, there was a trend showing an 85\% increase in the annual incidence of gastroschisis (p = 0.003) and the mortality was 33\% with a trend of decreasing (p = 0.002).},
	number = {1},
	urldate = {2025-11-25},
	journal = {Jornal de Pediatria},
	author = {Egger, Paulo Acácio and de Souza, Makcileni Paranho and Riedo, Cristiane de Oliveira and Dutra, Amanda de Carvalho and da Silva, Mariana Teixeira and Pelloso, Sandra Marisa and Carvalho, Maria Dalva de Barros},
	month = jan,
	year = {2022},
	keywords = {Abdominal wall, Annual incidence, Gastroschisis, Mortality, Prevalence},
	pages = {69--75},
	file = {ScienceDirect Full Text PDF:files/3306/Egger et al. - 2022 - Gastroschisis annual incidence, mortality, and trends in extreme Southern Brazil.pdf:application/pdf;ScienceDirect Snapshot:files/3305/S0021755721000796.html:text/html},
}

@article{schuh_birth_2025,
	title = {Birth {Prevalence} of {Gastroschisis} in the {United} {States}: 2016–2022},
	volume = {155},
	issn = {0031-4005},
	shorttitle = {Birth {Prevalence} of {Gastroschisis} in the {United} {States}},
	url = {https://doi.org/10.1542/peds.2024-068696},
	doi = {10.1542/peds.2024-068696},
	abstract = {The prevalence of gastroschisis has been increasing for decades globally across all ages and races/ethnicities and is one of few birth defects with rising prevalence in both developing and developed countries. However, there are some indications that rates in the United States may be declining. We aim to investigate national gastroschisis prevalence with 3 independent large-scale databases. We hypothesize that from 2016–2022, the data will congruently reveal a decline in gastroschisis prevalence in the United States.This study is a retrospective cross-sectional database review of 3 national datasets: 1 clinical outcomes-based dataset (the American College of Surgeons [ACS] National Surgical Quality Improvement Program—Pediatric [NSQIP-P] dataset), 1 administrative dataset (the Healthcare Cost and Utilization Project—National Inpatient Sample [HCUP-NIS]), and 1 public health-based dataset (the Center for Disease Control and Prevention Wide-ranging ONline Data for Epidemiologic Research [CDC WONDER]). Datasets were analyzed from 2016-2021/2022 for gastroschisis prevalence.From 2016–2022, the ACS NSQIP-P dataset revealed a decline in gastroschisis frequency from 0.32 to 0.19 per 100 infants. The HCUP-NIS dataset demonstrated a decline from 3.32 to 2.46 per 10 000 births. CDC WONDER data revealed a decline from 2.43 to 1.60 per 10 000 births.From 2016–2022, 3 large-scale national datasets congruently reveal a decline in gastroschisis prevalence in the United States for the first time in decades. The cause is likely multifactorial and should be further investigated.},
	number = {4},
	urldate = {2025-11-25},
	journal = {Pediatrics},
	author = {Schuh, Jennifer M. and Cabacungan, Erwin and Wagner, Amy J.},
	month = mar,
	year = {2025},
	pages = {e2024068696},
	file = {Snapshot:files/3308/peds.html:text/html},
}

